# Steam Web API key — get one at https://steamcommunity.com/dev/apikey
# (requires a Steam account with a non-limited status). Rate limit is
# roughly 100,000 calls per day per key.
STEAM_API_KEY=

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public origin of this app. Steam's OpenID flow posts the user back here,
# so it must match exactly what the browser uses.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite file for local dev. Swap for a Postgres URL when deploying.
DATABASE_URL=./umbrella.db
